{
  "name": "@vermeulen.solutions/eventual-attendance",
  "version": "0.1.1",
  "homepage": "https://eventual.rsvp/registrations/",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./sandbox": "./dist/plugin.mjs",
    "./astro": "./astro/index.ts",
    "./astro/RsvpForm.astro": "./astro/RsvpForm.astro",
    "./astro/RsvpManage.astro": "./astro/RsvpManage.astro"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "dist/manifest.json",
    "emdash-plugin.jsonc",
    "astro",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "emdash-plugin validate",
    "build": "npm run i18n:pack && emdash-plugin build",
    "typecheck": "tsc --noEmit",
    "check:contract": "node scripts/trust-contract.mjs",
    "check:size": "node scripts/bundle-size.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run && node scripts/trust-contract.mjs && node scripts/bundle-size.mjs",
    "i18n:pack": "node node_modules/@vermeulen.solutions/eventual-locales/scripts/pack-manifest.mjs attendance src/locales"
  },
  "peerDependencies": {
    "@emdash-cms/admin": ">=1.2.0 <2.0.0",
    "emdash": ">=1.2.0 <2.0.0"
  },
  "devDependencies": {
    "@emdash-cms/admin": "1.4.0",
    "@emdash-cms/plugin-cli": "0.13.5",
    "@emdash-cms/plugin-test": "0.2.11",
    "@vermeulen.solutions/eventual-capacity": "github:Vermeulen-Solutions/eventual-rsvp-library#91ad9bf17fa3d82163b39d10115b13204b11d2f3",
    "emdash": "1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@emdash-cms/blocks": "1.4.0",
    "@vermeulen.solutions/eventual-locales": "0.1.10",
    "zod": "4.5.4"
  }
}
